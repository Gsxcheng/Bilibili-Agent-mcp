# 复制为 .env（放在项目根目录，或 ~/.bilibili-agent-mcp/.env）后按需填写。
# 已在系统环境变量里设置的值优先，这里的不会覆盖它们。

# B 站 Cookie（可选）。不填 = 游客模式；填了才能用 1080P+、AI 字幕、稍后再看/收藏/历史/动态
BILIBILI_COOKIE=

# 下载目录（可选，默认 ~/Downloads/bilibili）
# BILIBILI_DOWNLOAD_DIR=D:/Videos/bilibili

# ffmpeg 路径（可选，默认用 PATH 里的 ffmpeg）
# BILIBILI_FFMPEG=C:/ffmpeg/bin/ffmpeg.exe

# 允许修改账号数据的工具（稍后再看增删），默认关闭
# BILIBILI_ALLOW_WRITE=false

# ---- 远程 HTTP 模式（--http）----
# 访问密钥（可选）。不填会自动生成并保存到 ~/.bilibili-agent-mcp/token
# 自己填的话至少 16 位，只能用字母、数字、- 和 _
# BILIBILI_MCP_TOKEN=

# 监听端口 / 地址（配合 Cloudflare Tunnel 保持默认即可）
# BILIBILI_MCP_PORT=8787
# BILIBILI_MCP_HOST=127.0.0.1

# 对外地址（可选，用于生成文件下载链接；默认从请求头自动识别）
# BILIBILI_MCP_PUBLIC_URL=https://bili.example.com
